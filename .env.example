# ============================================
# Print Shop Generator - Environment Variables
# ============================================
# Copia este archivo como .env y ajusta los valores

# Application
APP_ENV=development
APP_NAME="Print Shop Generator"
APP_VERSION=1.0.0

# Server
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=pretty

# Output
OUTPUT_DIR=./output
MAX_FILE_SIZE_MB=50
CLEANUP_DAYS=7

# Default Document Settings
DEFAULT_PAGE_SIZE=carta
DEFAULT_IMAGE_WIDTH_CM=10
DEFAULT_MARGINS_CM=1.5
DEFAULT_SPACING_CM=0.5
